---
/**
 * Newsletter signup, backed by a real EmDash form (via @emdash-cms/plugin-forms).
 *
 * The form itself ("newsletter-signup") is created once in the admin UI at
 * /_emdash/admin/plugins/emdash-forms -- see AGENTS.md for setup steps. This
 * component just renders whatever form matches `formId` and lays it out;
 * all color theming (the --ec-form-* variables) lives in each theme file
 * under the `.newsletter-form-wrap .ec-form` selector so it always wins over
 * the plugin's own defaults, regardless of stylesheet load order.
 */
import { Form } from "@emdash-cms/plugin-forms/ui";
import "@emdash-cms/plugin-forms/styles";

interface Props {
	title: string;
	subtitle: string;
	formId?: string;
}

const { title, subtitle, formId = "newsletter-signup" } = Astro.props;
---

<section class="newsletter-section" id="newsletter">
	<div class="newsletter-inner" data-reveal>
		<h2 class="newsletter-title">{title}</h2>
		<p class="newsletter-subtitle">{subtitle}</p>
		<div class="newsletter-form-wrap">
			<Form id={formId} />
		</div>
	</div>
</section>

<style>
	.newsletter-section {
		padding: var(--spacing-20) var(--spacing-6);
		text-align: center;
	}

	.newsletter-inner {
		max-width: 560px;
		margin: 0 auto;
	}

	.newsletter-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-3);
	}

	.newsletter-subtitle {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-8);
	}

	.newsletter-form-wrap {
		text-align: left;
	}

	/* Layout only -- colors come from theme.css's .ec-form overrides. */
	.newsletter-form-wrap :global(.ec-form) {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: flex-start;
	}

	.newsletter-form-wrap :global(.ec-form-page) {
		flex: 1;
		display: flex;
		flex-wrap: wrap;
		gap: inherit;
	}

	.newsletter-form-wrap :global(.ec-form-field) {
		flex: 1;
		min-width: 200px;
	}

	.newsletter-form-wrap :global(.ec-form-submit) {
		white-space: nowrap;
	}

	.newsletter-form-wrap :global(.ec-form-nav) {
		align-self: stretch;
	}

	@media (max-width: 640px) {
		.newsletter-section {
			padding: var(--spacing-12) var(--spacing-4);
		}

		.newsletter-form-wrap :global(.ec-form) {
			flex-direction: column;
		}

		.newsletter-form-wrap :global(.ec-form-submit) {
			width: 100%;
		}
	}
</style>
