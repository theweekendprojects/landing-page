---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	description?: string;
	featuredImage?: MediaValue | string;
	href: string;
	techStack?: string[];
	category?: string;
}

const { title, description, featuredImage, href, techStack, category } =
	Astro.props;

const categoryLabels: Record<string, string> = {
	web: "Web Application",
	mobile: "Mobile App",
	cli: "CLI Tool",
	library: "Library/Package",
	api: "API/Backend",
	design: "Design/UX",
	other: "Other",
};
---

<article class="project-card">
	<a href={href} class="card-link">
		{
			featuredImage ? (
				<div class="card-image">
					<Image image={featuredImage} />
				</div>
			) : (
				<div class="card-placeholder" />
			)
		}
		<div class="card-body">
			{category && (
				<span class="card-category">
					{categoryLabels[category] || category}
				</span>
			)}
			<h2 class="card-title">{title}</h2>
			{description && <p class="card-excerpt">{description}</p>}
			{techStack && techStack.length > 0 && (
				<div class="card-tech-stack">
					{techStack.slice(0, 3).map((tech) => (
						<span class="tech-tag">{tech}</span>
					))}
					{techStack.length > 3 && (
						<span class="tech-more">+{techStack.length - 3}</span>
					)}
				</div>
			)}
		</div>
	</a>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.card-link:hover .card-image img {
		transform: scale(1.03);
	}

	.card-placeholder {
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
	}

	.card-body {
		flex: 1;
	}

	.card-category {
		display: inline-block;
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.card-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.card-link:hover .card-title {
		color: var(--color-brand);
	}

	.card-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-4);
	}

	.tech-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: var(--radius);
	}

	.tech-more {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	@media (max-width: 600px) {
		.card-title {
			font-size: var(--font-size-lg);
		}
	}
</style>
