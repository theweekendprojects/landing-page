---
import { getMenu, getSiteSettings } from "emdash";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const menu = await getMenu("primary");
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const isLoggedIn = !!Astro.locals.user;
---

<nav class="mobile-nav" id="mobile-nav">
	<a href="/" class="mobile-logo">
		{siteTitle}
	</a>
	<button class="mobile-nav-toggle" aria-label="Toggle menu" aria-expanded="false">
		<span class="bar" />
		<span class="bar" />
		<span class="bar" />
	</button>
	<div class="mobile-nav-menu">
		{menu?.items.map((item) => (
			<a href={item.url} class="mobile-nav-link">
				{item.label}
			</a>
		))}
		{isLoggedIn && (
			<a href="/_emdash/admin" class="mobile-nav-admin">
				Admin
			</a>
		)}
	</div>
	<div class="mobile-nav-overlay" />
</nav>

<style>
	.mobile-nav {
		display: none;
		justify-content: space-between;
		align-items: center;
		padding: var(--spacing-3) var(--spacing-4);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
	}

	.mobile-logo {
		font-size: var(--font-size-base);
		font-weight: 700;
		color: var(--color-text);
		text-decoration: none;
	}

	.mobile-nav-toggle {
		display: flex;
		flex-direction: column;
		gap: 5px;
		width: 24px;
		height: 24px;
		cursor: pointer;
		border: none;
		background: transparent;
		padding: 0;
	}

	.bar {
		width: 100%;
		height: 2px;
		background: var(--color-text);
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	/* Hamburger to X animation */
	.mobile-nav-toggle[aria-expanded="true"] .bar:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	.mobile-nav-toggle[aria-expanded="true"] .bar:nth-child(2) {
		opacity: 0;
	}

	.mobile-nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
		transform: rotate(-45deg) translate(7px, -8px);
	}

	/* Sheet - slides in from right */
	.mobile-nav-menu {
		position: fixed;
		top: 64px;
		right: 0;
		width: 80%;
		max-width: 320px;
		height: calc(100vh - 64px);
		background: var(--color-bg);
		box-shadow: -5px 0 25px rgba(0, 0, 0, 0.3);
		transition: transform 0.3s ease;
		transform: translateX(100%);
		z-index: 1000;
		padding: var(--spacing-6) var(--spacing-4);
		overflow-y: auto;
	}

	.mobile-nav-menu.open {
		transform: translateX(0);
	}

	.mobile-nav-link {
		display: block;
		padding: var(--spacing-3) var(--spacing-2);
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--font-size-lg);
		border-radius: var(--radius);
		transition: background 0.2s ease;
	}

	.mobile-nav-link:hover {
		background: var(--color-surface);
	}

	.mobile-nav-admin {
		display: block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-2);
		color: var(--color-brand);
		text-decoration: none;
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	/* Overlay - covers the main content, not the nav bar */
	.mobile-nav-overlay {
		position: fixed;
		top: 64px;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.5);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s ease, visibility 0.3s ease;
		z-index: 999;
	}

	.mobile-nav-menu.open + .mobile-nav-overlay {
		opacity: 1;
		visibility: visible;
	}

	@media (max-width: 640px) {
		.mobile-nav {
			display: flex;
		}
	}

	@media (min-width: 641px) {
		.mobile-nav {
			display: none;
		}
	}
</style>

<style>
	/* When mobile nav is active, add padding to body to prevent content overlap */
	.mobile-nav-open body {
		padding-top: 128px;
	}

	@media (min-width: 641px) {
		.mobile-nav-open body {
			padding-top: 0;
		}
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const navToggle = document.querySelector(".mobile-nav-toggle");
		const navMenu = document.querySelector(".mobile-nav-menu");
		const navOverlay = document.querySelector(".mobile-nav-overlay");
		const body = document.body;

		if (!navToggle || !navMenu) return;

		navToggle.addEventListener("click", () => {
			const isExpanded = navToggle.getAttribute("aria-expanded") === "true";
			const isOpen = !isExpanded;
			navToggle.setAttribute("aria-expanded", isOpen);
			if (isOpen) {
				body.classList.add("mobile-nav-open");
			} else {
				body.classList.remove("mobile-nav-open");
			}
			navMenu.classList.toggle("open", isOpen);
		});

		if (navOverlay) {
			navOverlay.addEventListener("click", () => {
				navToggle.setAttribute("aria-expanded", "false");
				body.classList.remove("mobile-nav-open");
				navMenu.classList.remove("open");
			});
		}

		// Close menu when clicking links
		navMenu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => {
				navToggle.setAttribute("aria-expanded", "false");
				body.classList.remove("mobile-nav-open");
				navMenu.classList.remove("open");
			});
		});
	});
</script>
