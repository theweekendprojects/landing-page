---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { Image } from "emdash/ui";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const FEATURED_PROJECTS_LIMIT = 3;
const LATEST_POSTS_LIMIT = 4;

const [{ entries: projects }, { entries: posts }, settings] = await Promise.all([
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		limit: 12,
	}),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: LATEST_POSTS_LIMIT,
	}),
	getSiteSettings(),
]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

// Prefer projects explicitly marked featured; fall back to the most recent
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, FEATURED_PROJECTS_LIMIT);
const projectsForHome =
	featuredProjects.length > 0 ? featuredProjects : projects.slice(0, FEATURED_PROJECTS_LIMIT);

// Single batched query for tags across posts
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsForHome = posts.map((post) => ({
	id: post.id,
	title: post.data.title ?? "Untitled",
	excerpt: post.data.excerpt,
	featuredImage: post.data.featured_image,
	date: post.data.publishedAt ?? undefined,
	readingTime: getReadingTime(post.data.content),
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
	bylines: post.data.bylines ?? [],
}));

const projectsData = projectsForHome.map((project) => ({
	id: project.id,
	title: project.data.title ?? "Untitled",
	description: project.data.description,
	featuredImage: project.data.featured_image,
	techStack: project.data.tech_stack,
	category: project.data.category,
}));
---

<Base title={siteTitle} description={siteTagline}>
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-inner">
			<h1 class="hero-title">
				Creative coding <br />
				<span class="hero-title-gradient">beyond the 9-to-5</span>
			</h1>
			<p class="hero-subtitle">
				A community for weekend hackers and side-project builders. Show off your builds, share your journey, and discover inspiration for your next project.
			</p>
			<div class="hero-actions">
				<a href="/projects" class="btn btn-primary">Explore Projects</a>
				<a href="/posts" class="btn btn-secondary">Read the Blog</a>
			</div>
		</div>
	</section>

	<!-- Featured Projects Section -->
	{projectsData.length > 0 && (
		<section class="projects-section" id="projects">
			<div class="section-container">
				<header class="section-header">
					<h2 class="section-heading">Featured Projects</h2>
					<p class="section-subtitle">
						Hand-picked builds from the community's weekends.
					</p>
					<a href="/projects" class="view-all-link">View all projects →</a>
				</header>
				<div class="projects-grid">
					{projectsData.map((project, index) => (
						<div class="project-card-wrapper" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
							<article class="project-card">
								<a href={`/projects/${project.id}`} class="card-link">
									{
										project.featuredImage ? (
											<div class="card-image">
												<Image image={project.featuredImage} />
											</div>
										) : (
											<div class="card-placeholder">
												<span class="placeholder-text">{project.title}</span>
											</div>
										)
									}
									<div class="card-body">
										{project.category && (
											<span class="card-category">
												{project.category}
											</span>
										)}
										<h3 class="card-title">{project.title}</h3>
										{project.description && <p class="card-excerpt">{project.description}</p>}
										{project.techStack && project.techStack.length > 0 && (
											<div class="card-tech-stack">
												{project.techStack.slice(0, 3).map((tech) => (
													<span class="tech-tag">{tech}</span>
												))}
												{project.techStack.length > 3 && (
													<span class="tech-more">+{project.techStack.length - 3}</span>
												)}
											</div>
										)}
									</div>
								</a>
							</article>
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- Featured Posts Section -->
	{postsForHome.length > 0 && (
		<section class="posts-section">
			<div class="section-container">
				<header class="section-header">
					<h2 class="section-heading">Latest Articles</h2>
					<p class="section-subtitle">
						Writes about coding, design, and the creative process.
					</p>
					<a href="/posts" class="view-all-link">Read all posts →</a>
				</header>
				<div class="posts-grid">
					{postsForHome.map((post, index) => (
						<div class="post-card-wrapper" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
							<article class="post-card">
								<a href={`/posts/${post.id}`} class="card-link">
									{
										post.featuredImage ? (
											<div class="card-image">
												<Image image={post.featuredImage} />
											</div>
										) : (
											<div class="card-placeholder">
												<span class="placeholder-text">{post.title}</span>
											</div>
										)
									}
									<div class="card-body">
										<div class="post-meta">
											{post.date && <time>{post.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>}
											<span class="meta-dot" />
											<span>{post.readingTime} min read</span>
										</div>
										<h3 class="card-title">{post.title}</h3>
										{post.excerpt && <p class="card-excerpt">{post.excerpt}</p>}
										{post.tags.length > 0 && (
											<div class="post-tags">
												{post.tags.slice(0, 3).map((tag) => (
													<a href={`/tag/${tag.slug}`} class="post-tag">{tag.label}</a>
												))}
											</div>
										)}
									</div>
								</a>
							</article>
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- About Section -->
	<section class="about-section">
		<div class="section-container">
			<header class="section-header">
				<h2 class="section-heading">About The Weekend Projects</h2>
				<p class="section-subtitle">
					A community-driven space for developers who code for fun outside of work hours.
				</p>
			</header>
			<div class="about-content">
				<p>
					The Weekend Projects is a place for creative coders, hobbyists, and side-project enthusiasts to share their work, learn from each other, and find inspiration for their next build.
				</p>
				<p>
					We believe that programming should be fun, not just a job. Whether you're building a simple tool to automate your workflow, creating a game just for fun, or experimenting with new technologies - this is your home.
				</p>
				<div class="about-features">
					<div class="feature-item">
						<h4>Project Showcase</h4>
						<p>Display your weekend builds with screenshots, tech stack, and live demos.</p>
					</div>
					<div class="feature-item">
						<h4>Community Blog</h4>
						<p>Share your journey, lessons learned, and technical insights with fellow makers.</p>
					</div>
					<div class="feature-item">
						<h4>No Pressure</h4>
						<p>Zero engagement metrics, no ads, just pure creative coding for the joy of it.</p>
					</div>
				</div>
				<a href="/pages/about" class="btn btn-secondary">Learn more about us</a>
			</div>
		</div>
	</section>

	<!-- Newsletter Section -->
	<section class="newsletter-section">
		<div class="section-container">
			<div class="newsletter-content">
				<h2 class="newsletter-title">Stay in the loop</h2>
				<p class="newsletter-subtitle">
					Get notified when new projects are published. One email per project, no spam, unsubscribe anytime.
				</p>
				<form class="newsletter-form" action="/#newsletter" method="post">
					<div class="form-group">
						<input type="email" name="email" placeholder="Your email address" required class="form-input" />
						<button type="submit" class="btn btn-primary">Subscribe</button>
					</div>
					<p class="form-note">No spam. Unsubscribe anytime.</p>
				</form>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero-section {
		padding: var(--spacing-20) var(--spacing-6);
		background: linear-gradient(180deg, var(--color-bg-subtle) 0%, var(--color-bg) 100%);
	}

	.hero-inner {
		max-width: 760px;
		margin: 0 auto;
		text-align: center;
	}

	.hero-title {
		font-size: clamp(2.5rem, 6vw, var(--font-size-5xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-6);
	}

	.hero-title-gradient {
		background: linear-gradient(135deg, var(--color-brand), var(--theme-accent));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero-subtitle {
		font-size: clamp(1.125rem, 2.5vw, var(--font-size-xl));
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 560px;
		margin: 0 auto var(--spacing-10);
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-4);
		justify-content: center;
		flex-wrap: wrap;
	}

	.project-card-wrapper,
	.post-card-wrapper {
		transition: transform 0.3s ease;
	}

	.project-card-wrapper:hover,
	.post-card-wrapper:hover {
		transform: translateY(-8px);
	}

	.projects-section,
	.posts-section,
	.about-section {
		padding: var(--spacing-20) 0;
	}

	.section-container {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-6);
	}

	.section-header {
		text-align: center;
		margin-bottom: var(--spacing-12);
	}

	.section-heading {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.section-subtitle {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		max-width: 600px;
		margin: 0 auto;
	}

	.view-all-link {
		display: inline-block;
		margin-top: var(--spacing-4);
		font-weight: 500;
		color: var(--color-brand);
		text-decoration: none;
		transition: color 0.2s;
	}

	.view-all-link:hover {
		color: var(--color-brand-hover);
	}

	.projects-grid,
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-8);
	}

	.project-card,
	.post-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: all 0.3s ease;
	}

	.project-card:hover,
	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--color-border-subtle);
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-bg-subtle);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.project-card:hover .card-image img,
	.post-card:hover .card-image img {
		transform: scale(1.05);
	}

	.card-placeholder {
		aspect-ratio: 16 / 9;
		background: linear-gradient(135deg, var(--color-bg-subtle), var(--color-surface));
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.placeholder-text {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-display);
		color: var(--color-text-secondary);
		text-align: center;
		padding: var(--spacing-4);
		-webkit-background-clip: text;
		background-clip: text;
		background: linear-gradient(135deg, var(--color-text-secondary), var(--color-muted));
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-body {
		padding: var(--spacing-6);
	}

	.card-category,
	.card-title {
		color: var(--color-brand);
	}

	.card-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
	}

	.card-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-4);
	}

	.card-tech-stack,
	.post-tags {
		display: flex;
		gap: var(--spacing-2);
		flex-wrap: wrap;
	}

	.tech-tag,
	.post-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-bg-subtle);
		border-radius: var(--radius);
		text-decoration: none;
		transition: all 0.2s;
	}

	.tech-tag:hover,
	.post-tag:hover {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}

	.tech-more {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.post-meta {
		display: flex;
		gap: var(--spacing-3);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.about-section {
		background: linear-gradient(180deg, var(--color-bg-subtle) 0%, var(--color-bg) 100%);
	}

	.about-content {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.about-content p {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-6);
	}

	.about-features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--spacing-6);
		margin: var(--spacing-8) 0;
	}

	.feature-item h4 {
		font-size: var(--font-size-base);
		font-weight: var(--font-weight-heading);
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
	}

	.feature-item p {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.newsletter-section {
		padding: var(--spacing-20) 0;
	}

	.newsletter-content {
		max-width: 600px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter-title {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-4);
	}

	.newsletter-subtitle {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-8);
	}

	.newsletter-form {
		display: flex;
		gap: var(--spacing-4);
		justify-content: center;
		flex-wrap: wrap;
	}

	.form-group {
		display: flex;
		gap: var(--spacing-2);
		flex: 1;
		min-width: 300px;
	}

	.form-input {
		flex: 1;
		padding: var(--spacing-3) var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		color: var(--color-text);
		transition: all 0.2s;
	}

	.form-input:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.form-note {
		width: 100%;
		text-align: center;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-2);
		padding: var(--spacing-3) var(--spacing-6);
		border-radius: var(--radius-lg);
		font-size: var(--font-size-base);
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s;
	}

	.btn-primary {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
	}

	.btn-primary:hover {
		background: var(--color-brand-hover);
	}

	.btn-secondary {
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.btn-secondary:hover {
		border-color: var(--color-text-secondary);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.hero-section {
			padding: var(--spacing-16) var(--spacing-4);
		}

		.projects-section,
		.posts-section,
		.newsletter-section {
			padding: var(--spacing-12) 0;
		}

		.section-container {
			padding: 0 var(--spacing-4);
		}

		.projects-grid,
		.posts-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}

	@media (max-width: 600px) {
		.hero-title {
			font-size: clamp(1.75rem, 8vw, var(--font-size-3xl));
		}

		.hero-actions {
			flex-direction: column;
			width: 100%;
		}

		.btn {
			width: 100%;
		}

		.form-group {
			flex-direction: column;
		}

		.about-features {
			grid-template-columns: 1fr;
		}
	}
</style>
