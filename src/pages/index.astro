---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import Features from "../components/home/Features.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import LatestPosts from "../components/home/LatestPosts.astro";
import About from "../components/home/About.astro";
import Newsletter from "../components/home/Newsletter.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getThemeCopy } from "../content/theme-copy";

const themeCopy = getThemeCopy();

const FEATURED_PROJECTS_LIMIT = 3;
const LATEST_POSTS_LIMIT = 3;

const [{ entries: projects }, { entries: posts }, settings] = await Promise.all([
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		limit: 12,
	}),
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: LATEST_POSTS_LIMIT,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

// Prefer projects explicitly marked featured; fall back to the most recent
// ones so the section still renders something for a fresh seed.
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, FEATURED_PROJECTS_LIMIT);
const projectsForHome =
	featuredProjects.length > 0 ? featuredProjects : projects.slice(0, FEATURED_PROJECTS_LIMIT);

// Single batched query for tags across the posts we're rendering, instead
// of one getEntryTerms() call per post. Bylines are already hydrated on
// entry.data.bylines by getEmDashCollection.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsForHome = posts.map((post) => ({
	id: post.id,
	title: post.data.title ?? "Untitled",
	excerpt: post.data.excerpt,
	featuredImage: post.data.featured_image,
	date: post.data.publishedAt ?? undefined,
	readingTime: getReadingTime(post.data.content),
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
	bylines: post.data.bylines ?? [],
}));

const projectsData = projectsForHome.map((project) => ({
	id: project.id,
	title: project.data.title ?? "Untitled",
	description: project.data.description,
	featuredImage: project.data.featured_image,
	techStack: project.data.tech_stack,
	category: project.data.category,
}));

const features = [
	{
		icon: "🚀",
		title: "Project Showcase",
		description:
			"Publish your weekend builds and see them alongside the rest of the community's work.",
	},
	{
		icon: "💡",
		title: "Tutorials & Guides",
		description: "Read how other builders shipped their side projects, warts and all.",
	},
	{
		icon: "👥",
		title: "Community, Not Growth Hacking",
		description: "No engagement funnels. Just people who like building things after hours.",
	},
	{
		icon: "⚡",
		title: "Small, Finishable Ideas",
		description: "Browse projects scoped for a weekend, not a quarter.",
	},
];
---

<Base title={siteTitle} description={siteTagline}>
	<Hero
		eyebrow={themeCopy.hero.eyebrow}
		title={themeCopy.hero.title}
		subtitle={themeCopy.hero.subtitle}
		primaryCta={themeCopy.hero.primaryCta}
		secondaryCta={themeCopy.hero.secondaryCta}
	/>

	<Features
		title="Why The Weekend Projects?"
		subtitle="Everything you need to turn a weekend idea into something real."
		features={features}
	/>

	{projectsData.length > 0 && <FeaturedProjects projects={projectsData} />}

	{postsForHome.length > 0 && <LatestPosts posts={postsForHome} />}

	<About
		title={themeCopy.about.title}
		paragraphs={themeCopy.about.paragraphs}
		cta={{ label: "Read more about this site", href: "/pages/about" }}
	/>

	<Newsletter
		title="Get new projects in your inbox"
		subtitle="One email when something new ships. No spam, unsubscribe anytime."
	/>
</Base>
