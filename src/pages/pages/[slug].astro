---
import { getImage } from "astro:assets";
import { getEmDashEntry, decodeSlug, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import { EmVBPage, resolveEmVBPage } from "@perkyzz/emvb/astro";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
// Tailwind + daisyUI for EmVB provider elements, bundled by Astro (imported, not a <link>).
import "../../styles/emvb-daisyui.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

// An EmVB visual page for this slug wins over the collection's PortableText content (R-030).
const emvb =
	(await resolveEmVBPage(Astro, { getImage })) ??
	(await resolveEmVBPage(Astro, { collection: "pages", field: "canvas", getImage }));
const { entry: collectionPage, cacheHint } = emvb
	? { entry: null, cacheHint: undefined }
	: await getEmDashEntry("pages", slug);
const page = emvb?.entry ?? collectionPage;

if (!page) {
	return Astro.redirect("/404");
}

if (!emvb && cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

// SEO metadata for static page
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/pages/${slug}`,
	defaultOgImage: undefined,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	{
		emvb ? (
			<EmVBPage page={emvb} />
		) : (
			<article class="page-article">
				<header class="page-header">
					<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
				</header>

				<div class="page-content">
					<PortableText value={page.data.content} />
				</div>
			</article>
		)
	}
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: var(--spacing-6);
		border-left: 3px solid var(--color-border);
		color: var(--color-muted);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
