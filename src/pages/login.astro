---
import "../styles/tokens.css";
import "../styles/theme.css";

// Import Better Auth client
import { authClient, signIn } from "../lib/better-auth-client.js";
import { onMount } from "solid-js";
import { createEffect, createSignal } from "solid-js";

const { isLoading, session, error, signIn: signInAction } = authClient;

// Check if user is logged in
const isLoggedIn = () => !!session()?.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Login — The Weekend Projects</title>
		<style is:global>
			:root {
				--font-body: "Inter", system-ui, sans-serif;
				--color-bg: #ffffff;
				--color-bg-subtle: #f8f9fa;
				--color-surface: #ffffff;
				--color-text: #1a1a1a;
				--color-text-secondary: #6b7280;
				--color-brand: #0066cc;
				--color-brand-hover: #0052a3;
				--color-on-brand: #ffffff;
				--color-brand-ring: rgba(0, 102, 204, 0.2);
				--color-border: #e5e7eb;
				--color-border-subtle: #f3f4f6;
				--color-muted: #9ca3af;
				--border-radius: 8px;
				--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
				--spacing-2: 0.5rem;
				--spacing-3: 0.75rem;
				--spacing-4: 1rem;
				--spacing-6: 1.5rem;
				--spacing-8: 2rem;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--color-bg: #0a0a0a;
					--color-bg-subtle: #171717;
					--color-surface: #1f1f1f;
					--color-text: #f3f4f6;
					--color-text-secondary: #d1d5db;
					--color-brand: #0066cc;
					--color-brand-hover: #0052a3;
					--color-on-brand: #ffffff;
					--color-border: #374151;
					--color-border-subtle: #27272a;
					--color-muted: #9ca3af;
				}
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				font-family: var(--font-body);
				background: var(--color-bg);
				color: var(--color-text);
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
			}

			.auth-page {
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: var(--spacing-6);
			}

			.auth-container {
				max-width: 400px;
				width: 100%;
				padding: var(--spacing-8);
				background: var(--color-surface);
				border-radius: var(--border-radius);
				box-shadow: var(--shadow-md);
			}

			.auth-container h1 {
				margin: 0 0 var(--spacing-4);
				text-align: center;
				font-size: 1.875rem;
				font-weight: 600;
				color: var(--color-text);
			}

			.auth-container .tagline {
				text-align: center;
				color: var(--color-text-secondary);
				margin-bottom: var(--spacing-8);
				font-size: 0.875rem;
			}

			.auth-container .error {
				color: #ef4444;
				background: #fef2f2;
				padding: var(--spacing-3);
				border-radius: var(--border-radius);
				margin-bottom: var(--spacing-4);
				font-size: 0.875rem;
			}

			.login-form {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-4);
			}

			.form-group {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2);
			}

			.form-group label {
				font-weight: 600;
				color: var(--color-text);
				font-size: 0.875rem;
			}

			.form-group input {
				padding: var(--spacing-3);
				border: 1px solid var(--color-border);
				border-radius: var(--border-radius);
				font-size: 1rem;
				background: var(--color-bg-subtle);
				color: var(--color-text);
			}

			.form-group input:focus {
				outline: none;
				border-color: var(--color-brand);
				box-shadow: 0 0 0 2px var(--color-brand-ring);
			}

			.btn-primary {
				padding: var(--spacing-3);
				background: var(--color-brand);
				color: var(--color-on-brand);
				border: none;
				border-radius: var(--border-radius);
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: background-color 0.2s;
			}

			.btn-primary:hover {
				background: var(--color-brand-hover);
			}

			.btn-primary:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.divider {
				margin: var(--spacing-8) 0;
				border: none;
				border-top: 1px solid var(--color-border);
			}

			.or-text {
				text-align: center;
				color: var(--color-text-secondary);
				margin-bottom: var(--spacing-4);
			}

			.btn-social {
				width: 100%;
				padding: var(--spacing-3);
				background: var(--color-bg-subtle);
				border: 1px solid var(--color-border);
				border-radius: var(--border-radius);
				display: flex;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-3);
				font-size: 1rem;
				cursor: pointer;
				transition: background-color 0.2s, border-color 0.2s;
			}

			.btn-social:hover {
				background: var(--color-surface);
				border-color: var(--color-brand);
			}

			.btn-social:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.google-icon {
				width: 20px;
				height: 20px;
			}

			.forgot-password {
				text-align: center;
				margin-top: var(--spacing-4);
			}

			.forgot-password a {
				color: var(--color-brand);
				text-decoration: none;
				font-size: 0.875rem;
			}

			.forgot-password a:hover {
				text-decoration: underline;
			}

			.signup-link {
				text-align: center;
				margin-top: var(--spacing-4);
				color: var(--color-text-secondary);
				font-size: 0.875rem;
			}

			.signup-link a {
				color: var(--color-brand);
				text-decoration: none;
				font-weight: 600;
			}

			.signup-link a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<div class="auth-page">
			<main class="auth-container">
				<h1>Login</h1>
				<p class="tagline">Login to your account</p>

				{error() && (
					<div class="error">{error().message || "An error occurred"}</div>
				)}

				{!isLoading() && !isLoggedIn() && (
					<>
						<form
							method="POST"
							class="login-form"
							onSubmit={async (e) => {
								e.preventDefault();
								const formData = new FormData(e.currentTarget);
								const email = formData.get("email") as string;
								const password = formData.get("password") as string;
								await signIn.email(email, { password });
							}}
						>
							<div class="form-group">
								<label for="email">Email</label>
								<input
									id="email"
									name="email"
									type="email"
									placeholder="you@example.com"
									required
									defaultValue=""
								/>
							</div>

							<div class="form-group">
								<label for="password">Password</label>
								<input
									id="password"
									name="password"
									type="password"
									placeholder="••••••••"
									required
									defaultValue=""
								/>
							</div>

							<button
								type="submit"
								class="btn-primary"
								disabled={isLoading()}
							>
								Sign in
							</button>
						</form>

						<div class="forgot-password">
							<a href="/forgot-password">Forgot password?</a>
						</div>

						<hr class="divider" />
						<p class="or-text">Or continue with</p>

						<button
							type="button"
							class="btn-social"
							onClick={() => signIn.social({ provider: "google", callbackURL: "/" })}
							disabled={isLoading()}
						>
							<svg class="google-icon" viewBox="0 0 24 24">
								<path
									d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
									fill="#4285F4"
								/>
								<path
									d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
									fill="#34A853"
								/>
								<path
									d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.84z"
									fill="#FBBC05"
								/>
								<path
									d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
									fill="#EA4335"
								/>
							</svg>
							Continue with Google
						</button>

						<div class="signup-link">
							Don't have an account?{" "}
							<a href="/signup">Sign up</a>
						</div>
					</>
				)}

				{isLoading() && <p>Loading...</p>}

				{isLoggedIn() && (
					<div class="signup-link">
						<p>You are logged in. Redirecting...</p>
					</div>
				)}
			</main>
		</div>
	</body>
</html>
