---
// Public page built in the Puck editor (emdash-puck-editor). The plugin serves only published pages,
// so a draft never reaches this route. The page is read in-process through EmDash's public handler
// (the same way EmVB reads its pages), not with an HTTP call back to this site.
import Base from "../../layouts/Base.astro";
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import {
	DAISY_INTERACTIVE_RUNTIME,
	pageNeedsRuntime,
	renderPublicPage,
	type PublicTheme,
} from "@theweekendprojects/emdash-puck-editor/render";
import "@theweekendprojects/emdash-puck-editor/puck-canvas.css";

// The host owns the theme. The visitor's choice (the site's theme cookie) wins. With no choice, this
// site's design is dark, so the blocks are drawn in the dark theme; a site with a light design changes
// this one line.
const SITE_DEFAULT_THEME: PublicTheme = "dark";
const cookieTheme = Astro.cookies.get("theme")?.value;
const theme: PublicTheme = cookieTheme === "light" || cookieTheme === "dark" ? cookieTheme : SITE_DEFAULT_THEME;

const slug = Astro.params.slug ?? "";
const handler = getPublicPluginApiRouteHandler(Astro.locals as never);
if (!handler) {
	throw new Error("puck-editor: EmDash public plugin handler is not available");
}
const request = new Request(
	new URL(`/_emdash/api/plugins/puck-editor/page?slug=${encodeURIComponent(slug)}`, Astro.url),
);
const result = await handler("puck-editor", "GET", "/page", request);
if (!result.success) {
	if (result.error?.code === "NOT_FOUND" || result.error?.code === "BAD_REQUEST") {
		return Astro.redirect("/404");
	}
	throw new Error(`puck-editor: page lookup failed (${result.error?.code ?? "unknown"})`);
}
const page = result.data as {
	title: string;
	data: Parameters<typeof renderPublicPage>[0];
};
const html = renderPublicPage(page.data, { theme });
// Load the small browser script only when a block on this page needs it (modal, tabs, countdown...).
const needsRuntime = pageNeedsRuntime(page.data);
---

<Base title={page.title}>
	<main class="mx-auto max-w-5xl p-6">
		<Fragment set:html={html} />
	</main>
	{needsRuntime && <script is:inline set:html={DAISY_INTERACTIVE_RUNTIME}></script>}
</Base>
