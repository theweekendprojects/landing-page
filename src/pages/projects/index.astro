---
import { getEmDashCollection, getTermsForEntries, getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import { Image } from "emdash/ui";
import { getReadingTime } from "../../utils/reading-time";

const categoryLabels: Record<string, string> = {
	web: "Web Application",
	mobile: "Mobile App",
	cli: "CLI Tool",
	library: "Library/Package",
	api: "API/Backend",
	design: "Design/UX",
	other: "Other",
};

// Get all project categories for filtering
const categories = await getTaxonomyTerms("projects", "category");

const categoryParam = Astro.url.searchParams.get("category");
const filter = categoryParam ? { terms: { category: categoryParam } } : {};

const { entries: projects, cacheHint } = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
	...filter,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="All Projects" description="Browse all weekend projects">
	<div class="projects-page">
		<header class="page-header">
			<h1 class="page-title">All Projects</h1>
			<p class="page-description">
				{projects.length} {projects.length === 1 ? "project" : "projects"}
			</p>
		</header>

		<!-- Category Filter -->
		<div class="projects-filter">
			<button 
				class={`filter-btn ${!categoryParam ? 'active' : ''}`}
				onclick="window.location.search = 'category='"
			>
				All
			</button>
			{categories.map((category) => (
				<button 
					class={`filter-btn ${categoryParam === category.slug ? 'active' : ''}`}
					onclick={`window.location.search = 'category=${category.slug}'`}
				>
					{category.label}
				</button>
			))}
		</div>

		{
			projects.length === 0 ? (
				<p class="empty">No projects found.</p>
			) : (
				<div class="projects-grid">
					{projects.map((project, index) => {
						const techStack = project.data.tech_stack ?? [];
						return (
							<div class="project-card-wrapper" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
								<article class="project-card">
									<a href={`/projects/${project.id}`}>
										{
											project.data.featured_image ? (
												<div class="card-image">
													<Image image={project.data.featured_image} />
												</div>
											) : (
												<div class="card-placeholder" />
											)
										}
										<div class="card-body">
											{project.data.category && (
												<div class="project-tags">
													<span class="tag">
														{categoryLabels[project.data.category] ?? project.data.category}
													</span>
												</div>
											)}
											<h2 class="card-title">{project.data.title}</h2>
											{project.data.description && <p class="card-excerpt">{project.data.description}</p>}
											<div class="project-links">
												<a href={`/projects/${project.id}`} class="btn btn-primary">
													View Project →
												</a>
												{project.data.github_url && (
													<span>GitHub</span>
												)}
											</div>
										</div>
									</a>
								</article>
							</div>
						);
					})}
				</div>
			)
		}
	</div>
</Base>

</content>
