---
import { getEmDashCollection, getTermsForEntries, getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import { Image } from "emdash/ui";
import { getReadingTime } from "../../utils/reading-time";

const categoryLabels: Record<string, string> = {
	web: "Web Application",
	mobile: "Mobile App",
	cli: "CLI Tool",
	library: "Library/Package",
	api: "API/Backend",
	design: "Design/UX",
	other: "Other",
};

// Get all project categories for filtering
const categories = await getTaxonomyTerms("projects", "category");

const categoryParam = Astro.url.searchParams.get("category");
const filter = categoryParam ? { terms: { category: categoryParam } } : {};

const { entries: projects, cacheHint } = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
	...filter,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="All Projects" description="Browse all weekend projects">
	<div class="projects-page">
		<header class="page-header">
			<h1 class="page-title">All Projects</h1>
			<p class="page-description">
				{projects.length} {projects.length === 1 ? "project" : "projects"}
			</p>
		</header>

		<!-- Category Filter -->
		<div class="projects-filter">
			<button 
				class={`filter-btn ${!categoryParam ? 'active' : ''}`}
				onclick="window.location.search = 'category='"
			>
				All
			</button>
			{categories.map((category) => (
				<button 
					class={`filter-btn ${categoryParam === category.slug ? 'active' : ''}`}
					onclick={`window.location.search = 'category=${category.slug}'`}
				>
					{category.label}
				</button>
			))}
		</div>

		{
			projects.length === 0 ? (
				<p class="empty">No projects found.</p>
			) : (
				<div class="projects-grid">
					{projects.map((project, index) => {
						const techStack = project.data.tech_stack ?? [];
						return (
							<div class="project-card-wrapper" data-reveal style={`--reveal-delay: ${index * 0.1}s`}>
								<article class="project-card">
									<a href={`/projects/${project.id}`}>
										{
											project.data.featured_image ? (
												<div class="card-image">
													<Image image={project.data.featured_image} />
												</div>
											) : (
												<div class="card-placeholder" />
											)
										}
										<div class="card-body">
											{project.data.category && (
												<div class="project-tags">
													<span class="tag">
														{categoryLabels[project.data.category] ?? project.data.category}
													</span>
												</div>
											)}
											<h2 class="card-title">{project.data.title}</h2>
											{project.data.description && <p class="card-excerpt">{project.data.description}</p>}
											<div class="project-links">
												<a href={`/projects/${project.id}`} class="btn btn-primary">
													View Project →
												</a>
												{project.data.github_url && (
													<span>GitHub</span>
												)}
											</div>
										</div>
									</a>
								</article>
							</div>
						);
					})}
				</div>
			)
		}
	</div>
</Base>

<style>
	.projects-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		text-align: center;
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(1.75rem, 4vw, var(--font-size-3xl));
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
	}

	.projects-filter {
		display: flex;
		gap: var(--spacing-2);
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: var(--spacing-12);
	}

	.filter-btn {
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.filter-btn.active {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border-color: var(--color-brand);
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.project-card-wrapper {
		transition: transform 0.3s ease;
	}

	.project-card-wrapper:hover {
		transform: translateY(-8px);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-8);
	}

	.project-card {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: 2.5rem;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		border: 1px solid rgba(255, 255, 255, 0.05);
		position: relative;
		overflow: hidden;
	}

	.project-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: var(--theme-gradient-1);
		transform: scaleX(0);
		transform-origin: left;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.project-card:hover {
		transform: translateY(-12px);
		border-color: rgba(6, 182, 212, 0.3);
		box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
	}

	.project-card:hover::before {
		transform: scaleX(1);
	}

	.card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-bg-subtle);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.project-card:hover .card-image img {
		transform: scale(1.05);
	}

	.card-placeholder {
		aspect-ratio: 16 / 9;
		background: linear-gradient(135deg, var(--color-bg-subtle), var(--color-surface));
	}

	.card-body {
		padding: 0;
	}

	.card-title {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		color: #ffffff;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.card-title:hover {
		color: var(--color-brand);
	}

	.card-excerpt {
		color: var(--color-text-secondary);
		margin-bottom: 2rem;
	}

	.project-links {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 1.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-2);
		padding: var(--spacing-3) var(--spacing-6);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
		border-radius: 999px;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.btn-primary {
		background: var(--theme-gradient-1);
		color: #ffffff;
		border: none;
	}

	.btn-primary:hover {
		transform: translateY(-3px);
		box-shadow: 0 15px 30px rgba(6, 182, 212, 0.4);
	}

	.project-tags {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.tag {
		padding: 0.375rem 1rem;
		background: rgba(6, 182, 212, 0.1);
		color: var(--color-brand);
		border-radius: 20px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	@media (max-width: 900px) {
		.projects-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-2xl);
		}

		.projects-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		}
	}

	@media (max-width: 600px) {
		.projects-filter {
			gap: var(--spacing-1);
		}

		.filter-btn {
			padding: var(--spacing-2) var(--spacing-3);
			font-size: var(--font-size-xs);
		}
	}
</style>
