---
import "../styles/tokens.css";
import "../styles/theme.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Sign Up — The Weekend Projects</title>
		<style is:global>
			:root {
				--font-body: "Inter", system-ui, sans-serif;
				--color-bg: #ffffff;
				--color-bg-subtle: #f8f9fa;
				--color-surface: #ffffff;
				--color-text: #1a1a1a;
				--color-text-secondary: #6b7280;
				--color-brand: #0066cc;
				--color-brand-hover: #0052a3;
				--color-on-brand: #ffffff;
				--color-brand-ring: rgba(0, 102, 204, 0.2);
				--color-border: #e5e7eb;
				--color-border-subtle: #f3f4f6;
				--color-muted: #9ca3af;
				--border-radius: 8px;
				--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
				--spacing-2: 0.5rem;
				--spacing-3: 0.75rem;
				--spacing-4: 1rem;
				--spacing-6: 1.5rem;
				--spacing-8: 2rem;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--color-bg: #0a0a0a;
					--color-bg-subtle: #171717;
					--color-surface: #1f1f1f;
					--color-text: #f3f4f6;
					--color-text-secondary: #d1d5db;
					--color-brand: #0066cc;
					--color-brand-hover: #0052a3;
					--color-on-brand: #ffffff;
					--color-border: #374151;
					--color-border-subtle: #27272a;
					--color-muted: #9ca3af;
				}
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				font-family: var(--font-body);
				background: var(--color-bg);
				color: var(--color-text);
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
			}

			.auth-page {
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: var(--spacing-6);
			}

			.auth-container {
				max-width: 400px;
				width: 100%;
				padding: var(--spacing-8);
				background: var(--color-surface);
				border-radius: var(--border-radius);
				box-shadow: var(--shadow-md);
			}

			.auth-container h1 {
				margin: 0 0 var(--spacing-4);
				text-align: center;
				font-size: 1.875rem;
				font-weight: 600;
				color: var(--color-text);
			}

			.auth-container .tagline {
				text-align: center;
				color: var(--color-text-secondary);
				margin-bottom: var(--spacing-8);
				font-size: 0.875rem;
			}

			.signup-form {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-4);
			}

			.form-group {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2);
			}

			.form-group label {
				font-weight: 600;
				color: var(--color-text);
				font-size: 0.875rem;
			}

			.form-group input {
				padding: var(--spacing-3);
				border: 1px solid var(--color-border);
				border-radius: var(--border-radius);
				font-size: 1rem;
				background: var(--color-bg-subtle);
				color: var(--color-text);
			}

			.form-group input:focus {
				outline: none;
				border-color: var(--color-brand);
				box-shadow: 0 0 0 2px var(--color-brand-ring);
			}

			.btn-primary {
				padding: var(--spacing-3);
				background: var(--color-brand);
				color: var(--color-on-brand);
				border: none;
				border-radius: var(--border-radius);
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: background-color 0.2s;
			}

			.btn-primary:hover {
				background: var(--color-brand-hover);
			}

			.divider {
				margin: var(--spacing-8) 0;
				border: none;
				border-top: 1px solid var(--color-border);
			}

			.or-text {
				text-align: center;
				color: var(--color-text-secondary);
				margin-bottom: var(--spacing-4);
			}

			.btn-social {
				width: 100%;
				padding: var(--spacing-3);
				background: var(--color-bg-subtle);
				border: 1px solid var(--color-border);
				border-radius: var(--border-radius);
				display: flex;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-3);
				font-size: 1rem;
				cursor: pointer;
				transition: background-color 0.2s, border-color 0.2s;
			}

			.btn-social:hover {
				background: var(--color-surface);
				border-color: var(--color-brand);
			}

			.google-icon {
				width: 20px;
				height: 20px;
			}

			.btn-secondary {
				padding: var(--spacing-2) var(--spacing-4);
				background: transparent;
				border: 1px solid var(--color-border);
				border-radius: var(--border-radius);
				color: var(--color-text-secondary);
				cursor: pointer;
				transition: all 0.2s;
			}

			.btn-secondary:hover {
				background: var(--color-surface);
				border-color: var(--color-muted);
				color: var(--color-text);
			}

			.error-message {
				color: #ef4444;
				font-size: 0.875rem;
				text-align: center;
				margin-top: var(--spacing-2);
			}
		</style>
	</head>
	<body>
		<div class="auth-page">
			<main class="auth-container">
				<h1>Create an account</h1>
				<p class="tagline">Sign up to get started</p>

				<form method="POST" class="signup-form" id="signupForm">
					<div class="form-group">
						<label for="name">Name (optional)</label>
						<input id="name" name="name" type="text" placeholder="John Doe" />
					</div>

					<div class="form-group">
						<label for="email">Email</label>
						<input
							id="email"
							name="email"
							type="email"
							placeholder="you@example.com"
							required
						/>
					</div>

					<div class="form-group">
						<label for="password">Password</label>
						<input
							id="password"
							name="password"
							type="password"
							placeholder="••••••••"
							required
							minlength="8"
						/>
					</div>

					<button type="submit" class="btn-primary">
						Create account
					</button>
					<div id="errorMessage" class="error-message"></div>
				</form>

				<p class="tagline" style="margin-top: var(--spacing-6);">
					Already have an account? <a href="/login" style="color: var(--color-brand);">Login</a>
				</p>
			</main>
			<script>
				document.getElementById("signupForm").addEventListener("submit", async (e) => {
					e.preventDefault();
					const email = e.target.email.value;
					// Better-Auth requires a name; fall back to the email local-part.
					const name = e.target.name.value || email.split("@")[0];
					const password = e.target.password.value;
					const errorMessage = document.getElementById("errorMessage");

					try {
						const res = await fetch("/api/auth/sign-up/email", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({ email, password, name }),
						});

						if (res.ok) {
							const params = new URLSearchParams(window.location.search);
							window.location.href = params.get("redirect") || "/";
						} else {
							const data = await res.json();
							errorMessage.textContent = data.error || data.message || "Sign up failed";
						}
					} catch (err) {
						errorMessage.textContent = "Network error. Please try again.";
					}
				});
			</script>
		</div>
	</body>
</html>
