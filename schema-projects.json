{
  "slug": "projects",
  "label": "Projects",
  "labelSingular": "Project",
  "supports": ["drafts", "revisions", "search", "seo"],
  "fields": [
    {
      "slug": "title",
      "label": "Title",
      "type": "string",
      "required": true,
      "searchable": true
    },
    {
      "slug": "slug",
      "label": "Slug",
      "type": "string",
      "required": true,
      "helpText": "URL-friendly version of the title"
    },
    {
      "slug": "featured_image",
      "label": "Featured Image",
      "type": "image"
    },
    {
      "slug": "description",
      "label": "Short Description",
      "type": "text",
      "helpText": "Brief summary shown in project listings"
    },
    {
      "slug": "full_content",
      "label": "Full Content",
      "type": "portableText",
      "helpText": "Detailed project description, screenshots, technical details"
    },
    {
      "slug": "tech_stack",
      "label": "Tech Stack",
      "type": "array",
      "items": {
        "type": "string"
      },
      "helpText": "List of technologies used (comma separated)"
    },
    {
      "slug": "github_url",
      "label": "GitHub URL",
      "type": "string",
      "helpText": "Link to GitHub repository"
    },
    {
      "slug": "live_url",
      "label": "Live Demo URL",
      "type": "string",
      "helpText": "Link to live demo"
    },
    {
      "slug": "category",
      "label": "Category",
      "type": "string",
      "options": [
        { "value": "web", "label": "Web Application" },
        { "value": "mobile", "label": "Mobile App" },
        { "value": "cli", "label": "CLI Tool" },
        { "value": "library", "label": "Library/Package" },
        { "value": "api", "label": "API/Backend" },
        { "value": "design", "label": "Design/UX" },
        { "value": "other", "label": "Other" }
      ]
    },
    {
      "slug": "featured",
      "label": "Featured",
      "type": "boolean",
      "helpText": "Show this project on the homepage"
    },
    {
      "slug": "published_at",
      "label": "Published Date",
      "type": "datetime"
    }
  ]
}
