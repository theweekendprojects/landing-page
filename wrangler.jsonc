{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "landing-page",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Logs + Traces. Without this, the only way to see live behaviour
	// is `wrangler tail` (ephemeral); enabling it gives a searchable dashboard
	// for errors, slow renders, and request traces. Logs sampled at 100%.
	// Traces temporarily at 100% (was 0.01) to CAPTURE the cold-load slowness:
	// at 1% a specific slow cold request almost never lands in a trace, so you
	// can't see the per-query D1 timing. Drop back to ~0.05-0.1 once the cold
	// path is diagnosed and fixed, to keep trace volume/cost down on steady
	// traffic.
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 },
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "landing-page-db","database_id": "9e7ff73d-1f1e-4dab-a2b6-e45595762876",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "landing-page-media","preview_bucket_name": "landing-page-media",
		},
	],
	// Object cache (L2) for EmDash: caches content/config DB reads (settings,
	// menus, entries, taxonomies, bylines) in KV so cold renders / cache misses
	// serve those from KV instead of a D1 round trip. Epoch-invalidated on
	// publish — see astro.config.mjs `objectCache: kvCache(...)`.
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "7249f817e1534f139ba6872dfdf57a22",
		},
	],
	// Workers AI binding (tokenless). Available to plugins that need it.
	"ai": {
		"binding": "AI",
	},
	// Cloudflare AI Search namespace binding for emdash-ai-search (native). The
	// plugin calls AI_SEARCH.get(<instance name from settings>) and pushes content
	// into the instance's BUILT-IN STORAGE via the Items API — indexed per file,
	// immediately, no R2 bucket and no crawl/sync job. Just create the AI Search
	// instance in the dashboard (Compute & AI → AI Search) before deploying.
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
